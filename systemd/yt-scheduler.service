[Unit]
Description=Schedule next Sunday YouTube broadcasts
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yt-scheduler
Group=yt-scheduler
WorkingDirectory=/opt/yt-scheduler
StateDirectory=yt-scheduler
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/yt-scheduler/venv/bin/python /opt/yt-scheduler/schedule.py schedule --config /etc/yt-scheduler/config.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yt-scheduler
